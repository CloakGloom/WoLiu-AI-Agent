# ═══════════════════════════════════════════════════════════════
# AI Agent 环境变量模板
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传）
# ═══════════════════════════════════════════════════════════════

# ── LLM（必填，config.yaml 中 llm.api_key 引用） ──
SILICONFLOW_API_KEY=your_siliconflow_api_key

# ── 视觉模型（可选，简历/PPT 视觉质检） ──
VISION_API_KEY=your_vision_api_key
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=mimo-v2.5

# ── Python 环境（可选，config.yaml 引用） ──
# PYTHON_EXE=
# BASE_PYTHON=

# ── 联网搜索 / 网页抓取工具（可选） ──
# EXA_API_KEY=
# JINA_API_KEY=
# TAVILY_API_KEY=

# ── PPT 生成素材搜索（可选） ──
# PEXELS_API_KEY=

# ── ComfyUI（可选，留空则自动检测） ──
# COMFYUI_PATH=
